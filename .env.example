# ============================================================================
# AI 小说制作工坊 · 环境变量示例
# 复制此文件为 .env.local 并填入你的 API Key
# ============================================================================

# Google Gemini API（主用，默认 provider；免费额度充足）
# 注册地址：https://aistudio.google.com/ → Get API key（无需信用卡）
# 可用免费模型：gemini-3.6-flash（推荐，默认）/ gemini-3.5-flash / gemini-3.1-flash-lite
#（注意：gemini-2.5-flash / gemini-2.0-flash 等旧模型对新用户已下线或地区受限，勿用）
# 可选环境变量 GEMINI_DEFAULT_MODEL 覆盖默认模型
GEMINI_API_KEY=your-gemini-ai-studio-key

# 智谱 GLM API（辅助降级，瀑布流第 2）
# 注册地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key

# DeepSeek / 通义千问 API（可选备份）
# 注册地址：https://platform.deepseek.com/ ｜ https://dashscope.aliyun.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
QWEN_API_KEY=your-qwen-api-key

# LLM 路由限流（可选，默认开启）
# 基于 IP 对依赖 AI 配额的接口（chat / generate-chapter / embedding）限流，
# 防止部署后被外部滥用消耗配额。设为 false 可关闭。
LLM_RATE_LIMIT_ENABLED=true