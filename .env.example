# AI 小说制作工坊 · 环境变量示例
# 复制为 .env.local 并填入真实 API Key

# DeepSeek API（推荐主力模型，免费额度充足）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 智谱 GLM API（glm-4-flash 永久免费）
# 申请地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 通义 Qwen API（有免费额度）
# 申请地址：https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# 默认 LLM Provider（deepseek | zhipu | qwen）
DEFAULT_LLM_PROVIDER=deepseek
